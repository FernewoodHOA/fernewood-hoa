# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# --- Supabase (Project Settings -> API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key. Safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key. SECRET — bypasses row level security entirely.
# Server-side only. Never prefix with NEXT_PUBLIC_, never paste into chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- Board contact ----------------------------------------------------------
# Comma-separated recipients for Contact the Board submissions. Kept out of
# the repo so board members' addresses aren't published or scraped.
BOARD_EMAIL_TO=

# Comma-separated addresses granted FULL admin rights. This sends no email —
# it decides who becomes an admin when approved through the portal, and who
# scripts/bootstrap-admins.mjs promotes.
#
# Do NOT list read-only people here. Read-only access is set per profile
# (is_viewer), and adding someone here would silently upgrade them to full
# admin the next time they're approved or the bootstrap script runs.
ADMIN_EMAILS=

# --- Resend (email delivery) ------------------------------------------------
# https://resend.com — free tier covers this site's volume.
RESEND_API_KEY=

# Verified sender, e.g. "Fernewood HOA <noreply@fernewood.org>".
# The domain must be verified in Resend via DNS records at GoDaddy.
BOARD_EMAIL_FROM=

# --- Testing guard ----------------------------------------------------------
# While this is set, EVERY outbound email is redirected to this address
# instead of reaching residents, and is prefixed [TEST]. Essential while
# testing announcement blasts, which address residents directly and would
# otherwise bypass BOARD_EMAIL_TO. Leave empty/unset in production.
EMAIL_TEST_RECIPIENT=
